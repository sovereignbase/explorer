{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/explorer",
  "version": "0.0.0",
  "description": "WIP",
  "keywords": [
    "typescript",
    "sovereignbase"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "build": "npm run build:package && npm run build:docs",
    "build:package": "tsdown",
    "build:docs": "typedoc",
    "test": "npm run build && npm run typecheck && npm run test:vitest && npm run test:e2e",
    "typecheck": "tsc --noEmit --project test/tsconfig.json",
    "test:vitest": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench": "npm run build && node benchmark/bench.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.3",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/explorer.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/explorer/issues"
  },
  "homepage": "https://sovereignbase.dev/explorer",
  "dependencies": {
    "@sovereignbase/bytecodec": "^2.0.1",
    "@sovereignbase/cryptosuite": "^3.2.0",
    "@sovereignbase/dom-utils": "^1.0.1",
    "@sovereignbase/hardware-bound": "^2.0.2",
    "@sovereignbase/sequenced": "^0.0.2",
    "@sovereignbase/sequencer": "^1.1.1",
    "@sovereignbase/storage": "^3.2.0",
    "@sovereignbase/utils": "^2.6.0"
  }
}
